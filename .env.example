# API Key de Anthropic (requerida)
ANTHROPIC_API_KEY=tu_api_key_aqui

# Configuración del servidor MCP
MCP_SERVER_URL=http://localhost:3001/sse
# O si usas stdio local:
# MCP_SERVER_COMMAND=node
# MCP_SERVER_ARGS=mcp-server/server.js

# Puerto del agente HTTP
PORT=3000

# Modelo de Claude (opcional, default: claude-3-5-sonnet-20241022)
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Gmail OAuth (opcional - para procesador de tareas)
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret
# O poner credentials.json en data/
